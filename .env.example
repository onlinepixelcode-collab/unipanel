# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional: override the concierge model (default claude-sonnet-5-5)
ANTHROPIC_MODEL=
# Optional: forms POST JSON here (Zapier/Make/Formspree/your CRM). Without it forms open the routed showroom email.
FORM_WEBHOOK_URL=
# Where the site is served from (default /unipanel)
NEXT_PUBLIC_BASE_PATH=/unipanel
NEXT_PUBLIC_SITE_URL=https://demo.pixelcode.co.za
